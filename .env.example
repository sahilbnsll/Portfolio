# ==============================================================================
# AI Assistant (Sahil's AI Twin) Failover Keys
# The system automatically tries configured providers in prioritized cascade:
# 1. Google Gemini -> 2. Mistral -> 3. OpenRouter -> 4. Groq -> 5. GitHub Models
# ==============================================================================
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=

# Optional: Specific model overrides (leave blank to use auto-failover among verified models)
# Verified working models:
# - GEMINI: gemini-2.5-flash, gemini-flash-latest
# - MISTRAL: codestral-latest, ministral-8b-latest, ministral-14b-latest, ministral-3b-latest, open-mistral-nemo
# - OPENROUTER: nvidia/nemotron-3.5-lightning:free, nvidia/nemotron-3-super-120b-a12b:free, poolside/laguna-s-2.1:free
# - GROQ: groq/compound-mini, groq/compound, qwen/qwen3.8-27b, qwen/qwen3.6-27b, allam-2-7b, openai/gpt-oss-120b
# - GITHUB: gpt-4o-mini, Meta-Llama-3.1-8B-Instruct, Phi-3.5-mini-instruct
GEMINI_MODEL=
MISTRAL_MODEL=
OPENROUTER_MODEL=
GROQ_MODEL=
GITHUB_MODEL=

# ==============================================================================
# Vercel Web Analytics (Visitor Statistics Modal)
# ==============================================================================
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ==============================================================================
# Next.js Revalidation
# ==============================================================================
REVALIDATE_SECRET=